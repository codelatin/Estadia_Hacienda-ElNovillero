   <a href="https://api.whatsapp.com/send/?phone=573135825920&text&type=phone_number"
    target="_blank"
    aria-label="Escribir por WhatsApp"
    class="whatsapp-float relative shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-full bg-primary hover:bg-primary-container shadow-xl flex items-center justify-center transition-all duration-300 hover:scale-110"
  >
    <span class="whatsapp-ping absolute inset-0 rounded-full bg-primary"></span>
